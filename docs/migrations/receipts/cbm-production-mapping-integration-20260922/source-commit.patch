+ assert all("'" not in x and '\n' not in x for x in v.values())
+ t=p.with_name('.'+p.name+'.renewal');t.write_text(''.join(k+"='"+x+"'\n" for k,x in v.items()));t.chmod(0o600);t.replace(p)
