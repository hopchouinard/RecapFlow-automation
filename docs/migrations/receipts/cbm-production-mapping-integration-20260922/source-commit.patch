diff --git a/platform-services/community-brain-prod/production-mapping-033/deployed-mac/platform-services/community-brain-prod/integrations/renew-service-tokens.py b/platform-services/community-brain-prod/production-mapping-033/deployed-mac/platform-services/community-brain-prod/integrations/renew-service-tokens.py
