+            with r.quiet([lock],[]):lock.rename(self.root/'retained');lock.touch()
+    def test_source_drift_retains_incomplete_attempt(self):
+        real=r.tree;calls=0
+        def changing(*a,**kw):
+            nonlocal calls
+            calls+=1
+            if calls==2:(self.source/'data').write_text('changed')
