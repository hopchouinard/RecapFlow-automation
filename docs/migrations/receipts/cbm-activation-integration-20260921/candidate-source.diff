+            hashlib.sha256(
+                client.get("/" + str(path.relative_to("/dist"))).content
+            ).digest()
+            == hashlib.sha256(path.read_bytes()).digest()
+        )
+identity = {
+    "meeting_id": "old",
+    "local_date": "2026-09-08",
+    "started_at": "2026-09-08T22:00:00Z",
+    "timezone": "America/Toronto",
+    "provider": "manual",
+}
+source = store.add_source(
