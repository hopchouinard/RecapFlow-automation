# Environment variables (contains secrets)
.env
.env.*
!.env.example

# n8n persistent data
data/
raw-transcripts/

# Workflow runtime state (not source)
n8n-state/backfill-state.json
n8n-state/backfill-state.json.bak-*

# Docker
docker-compose.override.yml
.docker/

# Logs
*.log

# Python caches from deployment helpers and receipt verification
__pycache__/
*.py[cod]
.pytest_cache/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Vector database runtime files (3.8GB, rotates on every ingest)
community-brain/lancedb/

# Visual brainstorming companion runtime files
.superpowers/

# bats test cache
tests/.bats-cache/

# Restore staging dir created by bootstrap.sh
restore-staging/

# VM backup snapshots (contains encryption key + encrypted credentials — never commit)
backups/

# Bytecode from importlib-loaded scripts (tests/test_eval_fabrication_refusal.py)
scripts/__pycache__/
tests/cbm/__pycache__/
web/node_modules/
web/dist/
web/playwright-report/
web/test-results/
community-brain/migrations/__pycache__/
community-brain/migrations/versions/__pycache__/

# LanceDB pre-deploy snapshots — local rollback artifacts, not repo content
# (19M+ binaries; the VM is canonical and keeps them on disk)
community-brain/lancedb-backups/

# Eval run artifacts: persist the rendered context per D20, which means they
# carry transcript text. Durable on the VM, never in git (PC ceiling).
community-brain/eval-runs/

# Eval reports written by scripts/eval-fabrication.py. Per D20 these embed
# the rendered context (transcript text), so they must never reach git —
# including the script defaults and the paths its docstring examples use.
eval-*.json
