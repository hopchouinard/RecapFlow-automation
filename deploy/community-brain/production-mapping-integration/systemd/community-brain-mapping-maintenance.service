[Unit]
Description=Bound Community Brain maintenance with independent finalizer (proposal)
Requires=docker.service community-brain-mapping-recovery.service
After=docker.service community-brain-mapping-recovery.service
RequiresMountsFor=/srv/community-brain
[Service]
Type=oneshot
User=root
UMask=0077
RuntimeMaxSec=120
TimeoutStartSec=120
TimeoutStopSec=60
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /usr/local/lib/community-brain-production-mapping-033/service_recovery.py maintenance /srv/community-brain/maintenance-033/spec.json
ExecStopPost=/usr/bin/python3 -B /usr/local/lib/community-brain-production-mapping-033/service_recovery.py finalize /srv/community-brain/maintenance-033/spec.json
